# ── Clerk (authentication) ─────────────────────────────────────────
# Create a free app at https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Where Clerk redirects for sign-in/up (already set up in this app)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# ── Plaid (bank connections) ───────────────────────────────────────
# Create a free account at https://dashboard.plaid.com → Team Settings → Keys
# Start with "sandbox" (fake banks, test credentials: user_good / pass_good).
# Apply for Production access in the Plaid dashboard when ready to launch.
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox

# ── Stripe (subscription billing) ──────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ── Database (Neon Postgres) ──────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# ── Groq (AI assistant) ───────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxx

# Encryption key for Plaid tokens at rest — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_key
